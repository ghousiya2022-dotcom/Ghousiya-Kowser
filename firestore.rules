rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             data.role in ['patient', 'doctor'] &&
             data.onboarded is bool;
    }

    match /users/{userId} {
      allow get: if isVerified() && isOwner(userId);
      
      allow create: if isVerified() && isOwner(userId) && 
        isValidUser(incoming()) && 
        incoming().uid == request.auth.uid;
      
      allow update: if isVerified() && isOwner(userId) && 
        isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['onboarded', 'displayName', 'role']);

      match /patientDetails/basic {
        allow get, write: if isVerified() && isOwner(userId);
      }

      match /doctorDetails/basic {
        allow get, write: if isVerified() && isOwner(userId);
      }
    }
  }
}
